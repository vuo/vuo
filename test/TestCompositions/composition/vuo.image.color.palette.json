{"portConfiguration": {
  /* Map opaque orange to opaque red. */
  "opaque-to-opaque-glsl": {
    "firingPort": "image",
    "inputPortValues": {
      "image": {"color":{"r":0.7490196,"g":0.2901961,"b":0.1960784,"a":1},"pixelsWide":1,"pixelsHigh":1},
      "palette": [
        {"r":0,"g":0,"b":0,"a":1},
        {"r":1,"g":0.1,"b":0,"a":1},  // slightly off-red to accommodate drift due to the Metal shader's RGB->YUV->RGB conversion
      ],
      "dithering": 20,  // Bayer (GLSL)
      "ditheringIntensity": 0,
    },
    "outputPortValues": {
      "quantizedImage": {"color":{"r":1,"g":0.1,"b":0,"a":1},"pixelsWide":1,"pixelsHigh":1},
    }
  },
  "opaque-to-opaque-metal": {
    "firingPort": "image",
    "inputPortValues": {
      "dithering": 34,  // Floyd-Steinberg (Metal)
    },
    "outputPortValues": {
      "quantizedImage": {"color":{"r":1,"g":0.1,"b":0,"a":1},"pixelsWide":1,"pixelsHigh":1},
    }
  },

  /* Map opaque orange to semitransparent red. */
