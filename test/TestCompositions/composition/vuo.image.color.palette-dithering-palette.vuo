PublishedInputs [type="vuo.in" label="PublishedInputs|<palette>palette\r|<dithering>dithering\r" _palette_type="VuoList_VuoColor" _dithering_type="VuoInteger" _dithering_menuItems="[\"Noise\",\{\"value\":0,\"name\":\" \  \ White Noise\"\},\{\"value\":10,\"name\":\" \  \ Gradient Noise 0.05\"\},\{\"value\":11,\"name\":\" \  \ Gradient Noise 0.02\"\},\{\"value\":12,\"name\":\" \  \ Gradient Noise 0.01\"\},\"Ordered\",\{\"value\":20,\"name\":\" \  \ Bayer 2×2\"\},\{\"value\":24,\"name\":\" \  \ Bayer 3×3\"\},\{\"value\":21,\"name\":\" \  \ Bayer 4×4\"\},\{\"value\":22,\"name\":\" \  \ Bayer 8×8\"\},\{\"value\":23,\"name\":\" \  \ Bayer 16×16\"\},\"Error Diffusion\",\{\"value\":30,\"name\":\" \  \ South\"\},\{\"value\":31,\"name\":\" \  \ East\"\},\{\"value\":32,\"name\":\" \  \ South + East\"\},\{\"value\":33,\"name\":\" \  \ South + East + Southeast\"\},\{\"value\":34,\"name\":\" \  \ Floyd-Steinberg (1975)\"\},\{\"value\":35,\"name\":\" \  \ False Floyd-Steinberg\"\},\{\"value\":36,\"name\":\" \  \ Jarvis-Judice-Ninke (1976)\"\},\{\"value\":37,\"name\":\" \  \ Stucki (1981)\"\},\{\"value\":38,\"name\":\" \  \ Burkes (1988)\"\},\{\"value\":39,\"name\":\" \  \ Atkinson (1988)\"\},\{\"value\":40,\"name\":\" \  \ Sierra \\\"Three-Line\\\" 5×3 (1989)\"\},\{\"value\":41,\"name\":\" \  \ Sierra \\\"Two-Line\\\" 5×2 (1990)\"\},\{\"value\":42,\"name\":\" \  \ Sierra \\\"Filter Lite\\\" 3×2 (1990)\"\},\{\"value\":43,\"name\":\" \  \ Shiau-Fan 4×2 (1994)\"\},\{\"value\":44,\"name\":\" \  \ Shiau-Fan 5×2 (1994)\"\},\{\"value\":45,\"name\":\" \  \ Pigeon (2013)\"\}]" _dithering="34"];
PublishedOutputs [type="vuo.out" label="PublishedOutputs|<paletteAfterDithering>paletteAfterDithering\l" _paletteAfterDithering_type="VuoList_VuoColor"];

