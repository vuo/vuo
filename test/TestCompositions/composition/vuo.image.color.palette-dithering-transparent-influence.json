{"portConfiguration": [
  // When we render an image that's transparent on the top and solid 50% grey on the bottom,
  // and use error-diffusion dithering with a palette containing that same 50% grey,
  // we should get the same image (transparent top, solid 50% grey bottom) as output.
  // (Prior to https://b33p.net/kosada/vuo/vuo/-/merge_requests/451#note_2227751 (78d2b71e and cd728cc1),
  // unexpected colors (due to alpha division-by-zero)
  // and unexpected darkening (due to influence from transparent pixels)
  // were introduced along the boundary.)
  {
    "firingPort": "go",
    "outputPortValues": {
      "topColor":    "#00000000",  // transparent black
      "bottomColor": "#7f7f7f",    // solid 50% grey
      "ditheredPalette": [
        "#000000",  // unused colors, since `Make Palette from Image` adds solid black as padding
        "#000000",
        "#000000",
        "#000000",
        "#000000",
        "#000000",
        "#000000",
        "#7f7f7f",  // solid 50% grey
      ]
    }
  },
]}
