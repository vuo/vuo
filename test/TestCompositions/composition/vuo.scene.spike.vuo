RenderSceneToWindow [type="vuo.scene.render.image2" version="2.0.0" label="Render Scene to Image|<refresh>refresh\l|<objects>objects\l|<width>width\l|<height>height\l|<colorDepth>colorDepth\l|<multisampling>multisampling\l|<cameraName>cameraName\l|<image>image\r|<depthImage>depthImage\r" pos="735,165" fillcolor="blue" _width="640" _height="640" _colorDepth="\"8bpc\"" _multisampling="\"4\""];
