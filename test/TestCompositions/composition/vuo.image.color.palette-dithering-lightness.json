{"portConfiguration": {
  // When we render a solid-color greyscale image, dither it to black and white, then average the colors in the dithered image, we should get the same color that we started with.
  // (Prior to https://b33p.net/kosada/vuo/vuo/-/merge_requests/450 (6d29e615aaf092ca9b825b5e1303090e47983416), when dithering solid white, the result was darker than expected.)

  // Solid black and solid white give exact results.
  "black-whitenoise"         :{"firingPort":"lightness","inputPortValues":{"lightness":0.0,"dithering":0  /* White Noise         */},"outputPortValues":{"ditheredLightness":0.0}},
  "black-gradnoise-0.05"     :{"firingPort":"lightness","inputPortValues":{"lightness":0.0,"dithering":10 /* Gradient Noise 0.05 */},"outputPortValues":{"ditheredLightness":0.0}},
  "black-gradnoise-0.02"     :{"firingPort":"lightness","inputPortValues":{"lightness":0.0,"dithering":11 /* Gradient Noise 0.02 */},"outputPortValues":{"ditheredLightness":0.0}},
