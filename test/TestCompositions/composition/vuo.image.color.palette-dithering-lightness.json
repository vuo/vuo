  "black-bayer-2x2"          :{"firingPort":"lightness","inputPortValues":{"lightness":0.0,"dithering":20 /* Bayer 2×2           */},"outputPortValues":{"ditheredLightness":0.0}},
  "black-bayer-3x3"          :{"firingPort":"lightness","inputPortValues":{"lightness":0.0,"dithering":24 /* Bayer 3×3           */},"outputPortValues":{"ditheredLightness":0.0}},
  "black-bayer-4x4"          :{"firingPort":"lightness","inputPortValues":{"lightness":0.0,"dithering":21 /* Bayer 4×4           */},"outputPortValues":{"ditheredLightness":0.0}},
  "black-bayer-8x8"          :{"firingPort":"lightness","inputPortValues":{"lightness":0.0,"dithering":22 /* Bayer 8×8           */},"outputPortValues":{"ditheredLightness":0.0}},
  "black-bayer-16x16"        :{"firingPort":"lightness","inputPortValues":{"lightness":0.0,"dithering":23 /* Bayer 16×16         */},"outputPortValues":{"ditheredLightness":0.0}},
  "black-errordiffusion"     :{"firingPort":"lightness","inputPortValues":{"lightness":0.0,"dithering":34 /* Floyd-Steinberg     */},"outputPortValues":{"ditheredLightness":0.0}},

