  "grey-mid-bayer-16x16"     :{"firingPort":"lightness","inputPortValues":{"lightness":0.4,"dithering":23 /* Bayer 16×16         */},"outputPortValues":{"ditheredLightness":0.2}},  // @@@ should output 0.4
