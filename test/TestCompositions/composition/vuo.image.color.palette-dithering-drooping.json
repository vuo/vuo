{"portConfiguration": [
  // When we render an image that has a strong color in one area,
  // and use error-diffusion dithering with a palette that doesn't contain a good match,
  // the amount that the error is diffused should be limited,
  // so that the mismatched color doesn't droop/sag/bleed too far to the southeast.
  // (See `half di2` in `VuoErrorDiffusionDither.m`.)
  {
    "firingPort": "go",
    "outputPortValues": {
      "bottomRightColor": "#010005",  // Without clamping, the average color southeast of the mismatched region is much brighter (#110646).
    }
  },
]}
