digraph G
{
GetHSLColorValues [type="vuo.color.get.hsl" version="2.0.0" label="Get HSL Color Values|<refresh>refresh\l|<color>color\l|<hue>hue\r|<saturation>saturation\r|<lightness>lightness\r|<opacity>opacity\r" pos="900,60"];
MakeColorImage [type="vuo.image.make.color" version="1.0.1" label="Make Color Image|<refresh>refresh\l|<color>color\l|<width>width\l|<height>height\l|<image>image\r" pos="195,60" _width="64" _height="64"];
MakeHSLColor [type="vuo.color.make.hsl" version="2.0.0" label="Make HSL Color|<refresh>refresh\l|<hue>hue\l|<saturation>saturation\l|<lightness>lightness\l|<opacity>opacity\l|<color>color\r" pos="90,-45" _hue="0.0" _saturation="0.0" _opacity="1.0"];
MakeList [type="vuo.list.make.2.VuoColor" version="2.0.0" label="Make List|<refresh>refresh\l|<1>1\l|<2>2\l|<list>list\r" pos="398,86" _1="\"#000\"" _2="\"#fff\""];
MapImageToPalette [type="vuo.image.color.palette" version="1.1.0" label="Map Image to Palette|<refresh>refresh\l|<image>image\l|<palette>palette\l|<paletteMatchingAccuracy>paletteMatchingAccuracy\l|<dithering>dithering\l|<ditheringIntensity>ditheringIntensity\l|<quantizedImage>quantizedImage\r" pos="450,60" _paletteMatchingAccuracy="1" _ditheringIntensity="1"];
SampleColorFromImage [type="vuo.image.sample.color" version="1.1.1" label="Sample Color from Image|<refresh>refresh\l|<image>image\l|<center>center\l|<width>width\l|<sampleType>sampleType\l|<color>color\r" pos="690,60" _center="\{\"x\":0,\"y\":0\}" _width="2.0" _sampleType="\"average\""];
SnapValue [type="vuo.math.snap.VuoReal" version="1.0.0" label="Snap Value|<refresh>refresh\l|<value>value\l|<spacing>spacing\l|<center>center\l|<snappedValue>snappedValue\r" pos="1110,90" _spacing="0.10000000000000001" _center="0.0"];
PublishedInputs [type="vuo.in" label="PublishedInputs|<lightness>lightness\r|<dithering>dithering\r" _lightness_type="VuoReal" _lightness_suggestedMin="0" _lightness_suggestedMax="1" _lightness_suggestedStep="0.1" _lightness="0.5" _dithering_type="VuoInteger" _dithering_menuItems="[\"Noise\",\{\"value\":0,\"name\":\" \  \ White Noise\"\},\{\"value\":10,\"name\":\" \  \ Gradient Noise 0.05\"\},\{\"value\":11,\"name\":\" \  \ Gradient Noise 0.02\"\},\{\"value\":12,\"name\":\" \  \ Gradient Noise 0.01\"\},\"Ordered\",\{\"value\":20,\"name\":\" \  \ Bayer 2×2\"\},\{\"value\":24,\"name\":\" \  \ Bayer 3×3\"\},\{\"value\":21,\"name\":\" \  \ Bayer 4×4\"\},\{\"value\":22,\"name\":\" \  \ Bayer 8×8\"\},\{\"value\":23,\"name\":\" \  \ Bayer 16×16\"\},\"Error Diffusion\",\{\"value\":30,\"name\":\" \  \ South\"\},\{\"value\":31,\"name\":\" \  \ East\"\},\{\"value\":32,\"name\":\" \  \ South + East\"\},\{\"value\":33,\"name\":\" \  \ South + East + Southeast\"\},\{\"value\":34,\"name\":\" \  \ Floyd-Steinberg (1975)\"\},\{\"value\":35,\"name\":\" \  \ False Floyd-Steinberg\"\},\{\"value\":36,\"name\":\" \  \ Jarvis-Judice-Ninke (1976)\"\},\{\"value\":37,\"name\":\" \  \ Stucki (1981)\"\},\{\"value\":38,\"name\":\" \  \ Burkes (1988)\"\},\{\"value\":39,\"name\":\" \  \ Atkinson (1988)\"\},\{\"value\":40,\"name\":\" \  \ Sierra \\\"Three-Line\\\" 5×3 (1989)\"\},\{\"value\":41,\"name\":\" \  \ Sierra \\\"Two-Line\\\" 5×2 (1990)\"\},\{\"value\":42,\"name\":\" \  \ Sierra \\\"Filter Lite\\\" 3×2 (1990)\"\},\{\"value\":43,\"name\":\" \  \ Shiau-Fan 4×2 (1994)\"\},\{\"value\":44,\"name\":\" \  \ Shiau-Fan 5×2 (1994)\"\},\{\"value\":45,\"name\":\" \  \ Pigeon (2013)\"\}]" _dithering="23"];
PublishedOutputs [type="vuo.out" label="PublishedOutputs|<ditheredLightness>ditheredLightness\l" _ditheredLightness_type="VuoReal"];

GetHSLColorValues:lightness -> SnapValue:value;
MakeColorImage:image -> MapImageToPalette:image;
MakeHSLColor:color -> MakeColorImage:color;
MakeList:list -> MapImageToPalette:palette;
MapImageToPalette:quantizedImage -> SampleColorFromImage:image;
PublishedInputs:dithering -> MapImageToPalette:dithering;
PublishedInputs:lightness -> MakeHSLColor:lightness;
SampleColorFromImage:color -> GetHSLColorValues:color;
SnapValue:snappedValue -> PublishedOutputs:ditheredLightness;
}
