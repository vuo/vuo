MakeList6 [type="vuo.list.make.1.VuoColor" version="2.0.0" label="Make List|<refresh>refresh\l|<1>1\l|<list>list\r" pos="642,401" _1="\"#fff\""];
MakeList7 [type="vuo.list.make.2.VuoSceneObject" version="2.0.0" label="Make List|<refresh>refresh\l|<1>1\l|<2>2\l|<list>list\r" pos="854,191" fillcolor="blue"];
MakeOvalShader [type="vuo.shader.make.oval" version="1.0.0" label="Make Oval Shader|<refresh>refresh\l|<ovalColor>ovalColor\l|<ovalWidth>ovalWidth\l|<ovalSharpness>ovalSharpness\l|<haloColor>haloColor\l|<shader>shader\r" pos="375,150" _ovalColor="\{\"r\":1,\"g\":1,\"b\":1,\"a\":1\}" _ovalWidth="1.0" _ovalSharpness="1.0" _haloColor="\{\"r\":0.1,\"g\":0.2,\"b\":1,\"a\":1\}"];
MakePointsObject [type="vuo.scene.make.points.VuoPoint2d.VuoShader" version="1.0.0" label="Make Points Object|<refresh>refresh\l|<transform>transform\l|<material>material\l|<pointSize>pointSize\l|<positions>positions\l|<colors>colors\l|<object>object\r" pos="675,180" _transform="\{\"translation\":[0.0,0.0,0.0],\"eulerRotation\":[0.0,0.0,0.0],\"scale\":[-1.0,1.0,1.0]\}" _pointSize="0.050000000000000003"];
