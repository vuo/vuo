RenderSceneToWindow [type="vuo.scene.render.window2" version="3.1.0" label="Render Scene to Window|<refresh>refresh\l|<objects>objects\l|<background>background\l|<cameraName>cameraName\l|<multisampling>multisampling\l|<setWindowDescription>setWindowDescription\l|<updatedWindow>updatedWindow\r" pos="900,180" fillcolor="blue" _background="\"#000f\"" _multisampling="\"4\"" _updatedWindow_eventThrottling="enqueue"];

AllowFirstEvent2:firstEvent -> MakeOvalShader:ovalColor;
AllowFirstEvent:firstEvent -> MakeUnlitColorShader:color;
ConvertFrameToImage:image -> FindFacesInImage:image;
FindFacesInImage:lineSegments -> AllowFirstEvent:event;
FindFacesInImage:lineSegments -> MakeLinesObject:positions;
FindFacesInImage:points -> AllowFirstEvent2:event;
FindFacesInImage:points -> MakePointsObject:positions;
MakeLinesObject:object -> MakeList7:2;
