MakeLinesObject [type="vuo.scene.make.lines.VuoPoint2d.VuoShader" version="1.0.0" label="Make Lines Object|<refresh>refresh\l|<transform>transform\l|<material>material\l|<lineWidth>lineWidth\l|<positions>positions\l|<colors>colors\l|<object>object\r" pos="675,330" _transform="\{\"translation\":[0.0,0.0,0.0],\"eulerRotation\":[0.0,0.0,0.0],\"scale\":[-1.0,1.0,1.0]\}" _lineWidth="0.01"];
