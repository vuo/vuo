MakeList6:list -> MakeLinesObject:colors;
MakeList7:list -> RenderSceneToWindow:objects;
MakeOvalShader:shader -> MakePointsObject:material;
MakePointsObject:object -> MakeList7:1;
MakeUnlitColorShader:shader -> MakeLinesObject:material;
ReceiveLiveVideo:receivedFrame -> ConvertFrameToImage:frame;
