ChangeLayerBlending:blendedLayer -> MakeList:2;
ChangeSpeed:changedTime -> HoldValue4:value;
ChangeSpeed:changedTime -> HoldValue5:value;
ConvertFrameToImage:image -> FlipImageHorizontally:image;
ConvertImageToLayer3:layer -> ChangeLayerBlending:layer;
FindBodiesInImage:bodies -> GetFirstItemInList:list;
FireOnDisplayRefresh:requestedFrame -> BlendImageWithFeedback2:image [event=true style=invis];
FireOnDisplayRefresh:requestedFrame -> ChangeSpeed:time [style=invis];
FireOnDisplayRefresh:requestedFrame -> SmoothWithInertia2:time [style=invis];
FireOnDisplayRefresh:requestedFrame -> SmoothWithInertia4:time [style=invis];
FireOnDisplayRefresh:requestedFrame -> SmoothWithInertia5:time [style=invis];
FireOnDisplayRefresh:requestedFrame -> SmoothWithInertia:time [style=invis];
FlipImageHorizontally:flippedImage -> MakeImageLayer:image;
FlipImageHorizontally:flippedImage -> SpinOffValue:value;
GetBodyLandmarks:leftWrist -> SmoothWithInertia:setTarget;
GetBodyLandmarks:rightWrist -> SmoothWithInertia4:setTarget;
GetFirstItemInList:firstItem -> GetBodyLandmarks:body;
HoldValue4:heldValue -> MakeHSLColor:hue;
HoldValue5:heldValue -> MakeList2:1;
MakeHSLColor2:color -> MakeOvalLayer3:color;
MakeHSLColor:color -> MakeOvalLayer2:color;
MakeImageLayer:layer -> MakeList:1;
MakeList2:list -> Add:values;
MakeList5:list -> RenderLayersToImage2:layers;
MakeList:list -> RenderLayersToWindow:layers;
MakeOvalLayer2:layer -> MakeList5:1;
MakeOvalLayer3:layer -> MakeList5:2;
ReceiveLiveVideo:receivedFrame -> ConvertFrameToImage:frame;
RenderLayersToImage2:image -> BlendImageWithFeedback2:image;
SelectLatest3:latest -> AllowChanges2:value;
SelectLatest:latest -> AllowChanges:value;
SmoothWithInertia2:position -> MakeOvalLayer2:opacity;
SmoothWithInertia4:position -> HoldValue5:update;
SmoothWithInertia4:position -> MakeOvalLayer3:center;
SmoothWithInertia4:position -> SelectLatest3:option1 [event=true];
SmoothWithInertia4:reachedTarget -> SelectLatest3:option2;
SmoothWithInertia5:position -> MakeOvalLayer3:opacity;
SmoothWithInertia:position -> HoldValue4:update;
SmoothWithInertia:position -> MakeOvalLayer2:center;
SmoothWithInertia:position -> SelectLatest:option1 [event=true];
SmoothWithInertia:reachedTarget -> SelectLatest:option2;
SpinOffValue:spunOff -> FindBodiesInImage:image;
}
