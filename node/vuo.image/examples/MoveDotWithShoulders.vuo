Subtract [type="vuo.math.subtract.VuoReal" version="1.2.0" label="Subtract|<refresh>refresh\l|<a>a\l|<b>b\l|<difference>difference\r" pos="165,360"];

Comment [type="vuo.comment" label="\"If one shoulder is significantly higher than the other, update the dot's target position.\\n\\nUse the distance between the shoulders to scale the threshold, so that it works whether you're close to or far away from the camera.\"" pos="30,240" width="892" height="306"];

BecameGreaterThan2:becameLessThan -> SelectLatest:option2;
BecameGreaterThan:becameGreaterThan -> SelectLatest:option1;
Convert2DPointToReal2:y -> Subtract:b;
Convert2DPointToReal:y -> Subtract:a;
ConvertFrameToImage5:image -> FlipImageHorizontally:image;
ConvertRealTo2DPoint:point2d -> MakeOvalLayer:center;
Divide:quotient -> BecameGreaterThan:b;
Divide:quotient -> MakeList12:1;
FindFacesInImage:bodies -> GetFirstItemInList:list;
FireOnDisplayRefresh:requestedFrame -> SmoothWithSpring:time;
FireOnStart:started -> MakeOvalLayer:color [style=invis];
FireOnStart:started -> MakeTextLayer:text [style=invis];
FlipImageHorizontally:flippedImage -> MakeImageLayer2:image;
FlipImageHorizontally:flippedImage -> SpinOffValue:value;
GetBodyLandmarks:leftShoulder -> Convert2DPointToReal:xy;
GetBodyLandmarks:leftShoulder -> MeasureDistance3:a;
GetBodyLandmarks:rightShoulder -> Convert2DPointToReal2:xy;
GetBodyLandmarks:rightShoulder -> MeasureDistance3:b;
GetFirstItemInList:firstItem -> GetBodyLandmarks:body;
MakeImageLayer2:layer -> MakeList5:1;
MakeList12:list -> Multiply2:values;
MakeList5:list -> RenderLayersToWindow2:layers;
MakeOvalLayer:layer -> MakeList5:5;
MakeTextLayer:layer -> MakeList5:2;
MeasureDistance3:distance -> Divide:a;
Multiply2:product -> BecameGreaterThan2:b;
ReceiveLiveVideo2:receivedFrame -> ConvertFrameToImage5:frame;
SelectLatest:latest -> SmoothWithSpring:setTarget;
SmoothWithSpring:position -> ConvertRealTo2DPoint:x;
SpinOffValue:spunOff -> FindFacesInImage:image;
Subtract:difference -> BecameGreaterThan2:a;
Subtract:difference -> BecameGreaterThan:a;
}
