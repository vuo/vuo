AllowFirstEvent:firstEvent -> MakeParametricGridPoints:time;
Convert3DPointListTo2DPointList:xy -> CopyLayer:translations;
ConvertFrameToImage2:image -> FlipImageHorizontally:image;
CopyLayer:copies -> MakeList:2;
ExtractPeopleFromImage:people -> VignetteImage:image;
FireOnStart:started -> MakeCheckerboardImage:upperLeftColor;
FlipImageHorizontally:flippedImage -> ExtractPeopleFromImage:image;
InvertImageColors:invertedImage -> AllowFirstEvent:event;
InvertImageColors:invertedImage -> MakeCartoonImage2:image;
MakeCartoonImage2:cartoonImage -> MakeImageLayer2:image;
MakeCheckerboardImage:image -> MakeQuadLayer:image;
MakeImageLayer2:layer -> CopyLayer:layer;
MakeImageLayer3:layer -> MakeList:3;
MakeList2:list -> CopyLayer:scales;
MakeList4:list -> CopyLayer:rotations;
MakeList:list -> RenderLayersToWindow2:layers;
MakeParametricGridPoints:points -> Convert3DPointListTo2DPointList:xyz;
MakeQuadLayer:quad -> MakeList:1;
ReceiveLiveVideo:receivedFrame -> ConvertFrameToImage2:frame;
VignetteImage:vignettedImage -> InvertImageColors:image;
VignetteImage:vignettedImage -> MakeImageLayer3:image;
