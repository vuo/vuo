digraph G
{
ConvertFrameToImage2 [type="vuo.type.videoframe.image" version="1.0.0" label="Convert Frame to Image|<refresh>refresh\l|<frame>frame\l|<image>image\r" pos="765,510"];
ConvertImageToLayer [type="vuo.type.image.layer" version="1.0.0" label="Convert Image to Layer|<refresh>refresh\l|<image>image\l|<layer>layer\r" pos="1230,720"];
ConvertImageToLayer2 [type="vuo.type.image.layer" version="1.0.0" label="Convert Image to Layer|<refresh>refresh\l|<image>image\l|<layer>layer\r" pos="1230,735"];
ExtractPeopleFromImage [type="vuo.image.mask.people" version="1.0.0" label="Extract People from Image|<refresh>refresh\l|<image>image\l|<quality>quality\l|<people>people\r" pos="705,630" fillcolor="orange" _quality="0.5"];
FireOnStart2 [type="vuo.event.fireOnStart" version="1.0.0" label="Fire on Start|<refresh>refresh\l|<started>started\r" pos="705,420" fillcolor="lime" _started_eventThrottling="enqueue"];
FlipImageHorizontally [type="vuo.image.flip.horizontal" version="1.1.2" label="Flip Image Horizontally|<refresh>refresh\l|<image>image\l|<flippedImage>flippedImage\r" pos="705,570"];
MakeCheckerboardImage [type="vuo.image.make.checkerboard2" version="2.0.0" label="Make Checkerboard Image|<refresh>refresh\l|<upperLeftColor>upperLeftColor\l|<upperRightColor>upperRightColor\l|<squareSize>squareSize\l|<sharpness>sharpness\l|<angle>angle\l|<coverage>coverage\l|<center>center\l|<width>width\l|<height>height\l|<image>image\r" pos="945,420" _upperLeftColor="\{\"r\":0.26274511218070984,\"g\":0.27058824896812439,\"b\":0.35294118523597717,\"a\":1.0\}" _upperRightColor="\{\"r\":0.18039216101169586,\"g\":0.18823529779911041,\"b\":0.25490197539329529,\"a\":1.0\}" _squareSize="0.10000000000000001" _sharpness="1.0" _angle="0." _coverage="\{\"x\":0.5,\"y\":0.5\}" _center="\{\"x\":0.0,\"y\":0.0\}" _width="1024" _height="1024"];
MakeList [type="vuo.list.make.3.VuoLayer" version="2.0.0" label="Make List|<refresh>refresh\l|<1>1\l|<2>2\l|<3>3\l|<list>list\r" pos="1251,626" fillcolor="blue"];
ReceiveLiveVideo [type="vuo.video.receive2" version="2.0.0" label="Receive Live Video|<refresh>refresh\l|<device>device\l|<width>width\l|<height>height\l|<receivedFrame>receivedFrame\r" pos="705,480" fillcolor="lime" _width="0" _height="0" _receivedFrame_eventThrottling="drop"];
RenderLayersToWindow2 [type="vuo.layer.render.window2" version="3.1.0" label="Render Layers to Window|<refresh>refresh\l|<layers>layers\l|<background>background\l|<multisampling>multisampling\l|<setWindowDescription>setWindowDescription\l|<updatedWindow>updatedWindow\r" pos="1305,615" fillcolor="blue" _background="\{\"r\":0.0,\"g\":0.0,\"b\":0.0,\"a\":1.0\}" _multisampling="\"off\"" _updatedWindow_eventThrottling="enqueue"];

ConvertFrameToImage2:image -> FlipImageHorizontally:image;
ConvertImageToLayer2:layer -> MakeList:2;
ConvertImageToLayer:layer -> MakeList:1;
ExtractPeopleFromImage:people -> ConvertImageToLayer2:image;
FireOnStart2:started -> MakeCheckerboardImage:upperLeftColor;
FlipImageHorizontally:flippedImage -> ExtractPeopleFromImage:image;
MakeCheckerboardImage:image -> ConvertImageToLayer:image;
MakeList:list -> RenderLayersToWindow2:layers;
ReceiveLiveVideo:receivedFrame -> ConvertFrameToImage2:frame;
}
